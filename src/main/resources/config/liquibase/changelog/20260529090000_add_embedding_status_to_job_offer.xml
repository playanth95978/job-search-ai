<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260529090000-1" author="junie">
        <addColumn tableName="job_offer">
            <column name="embedding_status" type="varchar(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="embedding_model" type="varchar(255)"/>
            <column name="reindex_version" type="integer" defaultValueNumeric="1"/>
            <column name="retry_count" type="integer" defaultValueNumeric="0"/>
            <column name="indexing_error" type="text"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
