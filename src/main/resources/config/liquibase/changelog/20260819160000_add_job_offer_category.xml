<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260819160000-1" author="claude">
    <!--
      Job family, derived from the title at ingestion by JobCategoryClassifier: the sources share no
      taxonomy, so this is the only way the Category filter can be a plain Specification.
      Existing rows stay null until the backfill endpoint runs (POST /api/job-copilot/jobs/backfill-categories);
      null is filtered out of the facet counts, so an un-backfilled corpus degrades quietly instead of
      showing a bogus "other" bucket.
    -->
    <addColumn tableName="job_offer">
      <column name="category" type="varchar(40)"/>
    </addColumn>
    <createIndex tableName="job_offer" indexName="idx_job_offer_category">
      <column name="category"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
