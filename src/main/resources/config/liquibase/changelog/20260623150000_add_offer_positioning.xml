<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Persistent cache of the AI "positioning" analysis (candidate vs job offer). Avoids re-calling
        the LLM when the user re-opens the same offer. One row per (user_id, job_offer_id).
    -->
    <changeSet id="20260623150000-1" author="claude">
        <createTable tableName="offer_positioning">
            <column name="id" type="${uuidType}" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="job_offer_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
        </createTable>

        <addUniqueConstraint
            tableName="offer_positioning"
            columnNames="user_id, job_offer_id"
            constraintName="ux_offer_positioning_user_offer"/>
    </changeSet>

</databaseChangeLog>
