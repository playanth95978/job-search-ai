## ===================================================================
## Production environment for the Docker stack (deploy/docker-compose.prod.yml).
## Copy to deploy/.env and fill every value. NEVER commit deploy/.env.
##
##   cp deploy/.env.example deploy/.env && nano deploy/.env
## ===================================================================
#
## --- Domain / TLS (used by nginx + certbot) ------------------------
#DOMAIN=jobsearch.example.com
#LETSENCRYPT_EMAIL=you@example.com
#
## --- PostgreSQL (ParadeDB = pgvector + BM25) -----------------------
#POSTGRES_DB=job-search-ai
#POSTGRES_USER=job-search-ai
## Generate: openssl rand -hex 24
#POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
#
## --- Spring datasource (must match the POSTGRES_* values above) -----
#SPRING_DATASOURCE_URL=jdbc:postgresql://postgresql:5432/job-search-ai
#SPRING_DATASOURCE_USERNAME=job-search-ai
#SPRING_DATASOURCE_PASSWORD=CHANGE_ME_strong_db_password
#
## --- Security: JWT signing secret (REQUIRED) ------------------------
## Generate: openssl rand -base64 64   (then remove any line breaks)
#JWT_BASE64_SECRET=CHANGE_ME_base64_64_bytes
#
## --- Mistral AI (chat + CV OCR) — REQUIRED for AI features ----------
## Rotate the old leaked key; get a new one at https://console.mistral.ai
#MISTRALAI_API_KEY=CHANGE_ME_mistral_api_key
#
## --- Ollama (embeddings: nomic-embed-text, mxbai-embed-large) -------
## In the compose stack the app reaches the ollama service by name:
#OLLAMA_BASE_URL=http://ollama:11434
## Only needed if you use an Ollama CLOUD model (else leave empty):
#OLLAMA_TOKEN=
#OLLAMA_MODEL=nemotron-3-super:cloud
#
## --- France Travail connector (optional) ---------------------------
#FRANCE_TRAVAIL_CLIENT_ID=
#FRANCE_TRAVAIL_CLIENT_SECRET=
#
## --- Mail (registration / password reset) --------------------------
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=
#JHIPSTER_MAIL_FROM=job-search-ai@localhost
#JHIPSTER_MAIL_BASE_URL=https://jobsearch.example.com
#
## --- JVM heap (raise on a bigger VPS) ------------------------------
#JAVA_OPTS=-Xmx2g -Xms512m
